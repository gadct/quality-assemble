{
  "manifest_version": 3,
  "name": "Quality Assemble",
  "description": "Guía, registro y evidencia para QA manual. Todo se guarda en este equipo.",
  "version": "0.2.0",
  "key": "",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Abrir Quality Assemble"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "capture-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "capture-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
